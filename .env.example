JH_DATA_DIR=.local-data
# Optional first-run import; unset means an empty profile with guided onboarding.
# JH_PROFILE_SEED=/absolute/path/to/profile.json
JH_HOST=127.0.0.1
JH_PORT=3000
JH_TIMEZONE=Asia/Kuala_Lumpur
JH_SCAN_INTERVAL_HOURS=4
JH_CODEX_MODEL=gpt-5.6-sol
JH_CODEX_REASONING_EFFORT=high
# On Unraid, use /config/codex; development can use the current official Codex login.
JH_CODEX_HOME=
JH_X_BEARER_TOKEN=
JH_WEB3_API_TOKEN=
# Optional LaTeX overrides; Docker includes the compiler, sandbox and package cache.
# JH_TECTONIC_BIN=/absolute/path/to/tectonic
# JH_LATEX_CACHE=/absolute/path/to/package-cache
# JH_LATEX_SANDBOX=/usr/local/bin/ununemploy-tex-sandbox

# Optional TypeSafe Jev assessment; dashboard key configuration takes precedence.
JH_JEV_API_KEY=
