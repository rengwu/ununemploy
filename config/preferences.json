{
  "schemaVersion": 1,
  "status": "implemented_local_application",
  "ui": {
    "reference": "cloudflare_dashboard",
    "componentLibrary": "@cloudflare/kumo",
    "frontend": "react_typescript_vite",
    "ornamentalCopy": false,
    "decorativeFlourishes": false,
    "actionLabels": "literal_conventional",
    "discussionStatus": "approved",
    "homeScreen": "job_inbox_with_filters_and_detail_pane",
    "cvEditingWorkflow": "structured_json_and_html_css_source_with_preview",
    "guidance": "docs/UI_DESIGN.md"
  },
  "deployment": {
    "target": "unraid_home_network",
    "hostedSitesAllowed": false,
    "publicDeploymentAllowed": false,
    "applicationLogin": false,
    "containerPort": 3000,
    "suggestedHostPort": 3080,
    "dataDirectory": "/config"
  },
  "ai": {
    "provider": "official_codex_runtime",
    "authentication": "chatgpt_subscription",
    "model": "gpt-5.6-sol",
    "reasoningEffort": "high",
    "maxConcurrentRuns": 1,
    "subscriptionAllowanceShared": true,
    "onUsageLimit": "pause_and_retry_after_reset",
    "onAuthenticationFailure": "pause_for_sign_in",
    "onModelUnavailable": "pause_and_report",
    "automaticModelFallback": false,
    "automaticApiBillingFallback": false,
    "persistentRuntimeDirectory": "/config/codex"
  },
  "collection": {
    "intervalHours": 4,
    "timeZone": "Asia/Kuala_Lumpur",
    "xMonthlyPostLimit": 1000,
    "xPaceAcrossRemainingMonth": true
  },
  "cv": {
    "generateOnSave": true,
    "preserveUserEdits": true,
    "presentationEditable": true
  },
  "actions": {
    "submitApplications": false,
    "uploadCvToEmployers": false,
    "fillExternalApplicationForms": false,
    "sendMessages": false,
    "postRepliesOrComments": false,
    "followOrReact": false,
    "externalNotifications": false
  }
}
