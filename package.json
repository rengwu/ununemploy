{
  "name": "ununemploy",
  "version": "0.2.0-beta.7",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "predev": "tsx scripts/setup-latex.ts --startup",
    "prestart": "tsx scripts/setup-latex.ts --startup",
    "setup:latex": "tsx scripts/setup-latex.ts",
    "dev": "concurrently --kill-others --names api,web,worker \"tsx watch server/index.ts\" \"vite --host 0.0.0.0\" \"tsx watch worker/index.ts\"",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit",
    "start": "tsx server/index.ts",
    "worker": "tsx worker/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "scan": "tsx scripts/scan.ts",
    "desktop:build": "tsx scripts/build-desktop.ts",
    "desktop:build:windows": "tsx scripts/build-desktop-windows.ts",
    "desktop:setup:windows": "tsx scripts/build-windows-setup.ts",
    "desktop:install": "tsx scripts/install-desktop.ts",
    "desktop:test": "cd desktop && go test -race ./..."
  },
  "dependencies": {
    "@assistant-ui/react": "0.15.21",
    "@base-ui/react": "1.8.0",
    "@codemirror/language": "6.12.1",
    "@codemirror/legacy-modes": "6.5.2",
    "@codemirror/view": "6.39.11",
    "@earendil-works/pi-ai": "1.3.0",
    "@fastify/formbody": "9.0.0",
    "@fastify/static": "10.1.3",
    "@phosphor-icons/react": "2.1.10",
    "@uiw/react-codemirror": "4.25.11",
    "docx": "9.7.1",
    "domhandler": "6.0.1",
    "domutils": "4.0.2",
    "fast-xml-parser": "5.11.1",
    "fastify": "5.12.4",
    "handlebars": "4.7.9",
    "htmlparser2": "12.0.0",
    "ipaddr.js": "2.5.0",
    "jszip": "3.10.2",
    "pdfjs-dist": "5.4.624",
    "playwright": "1.63.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "sanitize-html": "2.17.7",
    "tsx": "4.23.13",
    "undici": "7.29.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sanitize-html": "2.16.1",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "10.0.5",
    "esbuild": "0.28.2",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "vite": "8.3.0"
  }
}
